# Required for Supabase authentication and app data access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required by server-side API routes that use the Supabase service role.
# Keep this secret; never use a NEXT_PUBLIC_ prefix for it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: set this to protect the overdue-notification cron endpoint.
CRON_SECRET=replace-with-a-long-random-secret

# Optional: required only when sending mail through Gmail SMTP.
GMAIL_USER=
GMAIL_APP_PASSWORD=